{
  "name": "streetzone",
  "version": "1.0.0",
  "description": "StreetZone - tienda de ropa (frontend puro) con despliegue continuo con CircleCI",
  "private": true,
  "scripts": {
    "start": "node scripts/serve.js",
    "validate": "node scripts/validate.js",
    "test": "node --test",
    "build": "node scripts/build.js",
    "ci": "npm run validate && npm test && npm run build",
    "test:junit": "node --test --test-reporter=junit --test-reporter-destination=test-results.xml",
    "deploy:staging": "node scripts/deploy.js staging",
    "deploy:prod": "node scripts/deploy.js prod"
  },
  "engines": {
    "node": ">=18"
  }
}
